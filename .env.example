# Google Gemini API key (server-side only — never expose to client code)
GEMINI_API_KEY=

# Optional. Gemini model id (default: gemini-3.8-flash). Never use retired gemini-2.0-* ids.
# GEMINI_MODEL=gemini-3.8-flash

# Optional. AI call timeout in ms before the DEMO-FALLBACK kicks in (default: 5000).
# AI_TIMEOUT_MS=5000

# Optional. Set to 1 to skip Gemini entirely and always use the deterministic fallbacks
# (used by Playwright tests and when live calls should be avoided).
# AI_FORCE_FALLBACK=1
